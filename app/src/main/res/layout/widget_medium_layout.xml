<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_shape"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="16dp">

    <!-- Left Pane - Next Prayer & Countdown -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical|start"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHOLAT SELANJUTNYA"
            android:textColor="@color/gold_primary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maghrib"
            android:textColor="@color/gold_light"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17:58 WIB"
            android:textColor="@color/teal_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_prayer_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-01:32:04"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Vertical elegant divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#33E5AF10"
        android:layout_marginVertical="6dp" />

    <!-- Right Pane - Calendar Dates & Location info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:gravity="center_vertical|end"
        android:paddingStart="12dp">

        <!-- Modern Hijri label badge -->
        <TextView
            android:id="@+id/widget_hijri_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19 Zulhijjah 1447 H"
            android:textColor="@color/gold_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/widget_gregorian_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selasa, 5 Juni 2026"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:gravity="end"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/widget_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menteng, Jakarta"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
