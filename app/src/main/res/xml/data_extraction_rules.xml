<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude EncryptedSharedPreferences (kunci terikat ke KeyStore perangkat asli, merestore akan crash) -->
        <exclude domain="sharedpref" path="adzan_secure_prefs.xml" />
        
        <!-- Exclude data lokasi GPS sensitif untuk privasi pengguna -->
        <exclude domain="sharedpref" path="user_location_cache.xml" />
        
        <!-- Exclude database lokal yang berisi cache jadwal & cuaca -->
        <exclude domain="database" path="prayer_qibla_db" />
        <exclude domain="database" path="prayer_qibla_db-shm" />
        <exclude domain="database" path="prayer_qibla_db-wal" />
        
        <!-- Exclude file audio Adzan custom berukuran besar -->
        <exclude domain="file" path="adzan.mp3" />
        <exclude domain="file" path="adzan_fajr.mp3" />

        <!-- Include pengaturan dasar non-sensitif (Tema, bookmarks, kustomisasi suara) -->
        <include domain="sharedpref" path="adzan_secure_prefs_plain_fallback.xml" />
        <include domain="sharedpref" path="adzan_individual_prefs.xml" />
        <include domain="sharedpref" path="quran_bookmarks.xml" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Exclude data terikat hardware pada saat transfer langsung antar perangkat -->
        <exclude domain="sharedpref" path="adzan_secure_prefs.xml" />
        <exclude domain="sharedpref" path="user_location_cache.xml" />
        <exclude domain="database" path="prayer_qibla_db" />
        <exclude domain="database" path="prayer_qibla_db-shm" />
        <exclude domain="database" path="prayer_qibla_db-wal" />
        <exclude domain="file" path="adzan.mp3" />
        <exclude domain="file" path="adzan_fajr.mp3" />

        <include domain="sharedpref" path="adzan_secure_prefs_plain_fallback.xml" />
        <include domain="sharedpref" path="adzan_individual_prefs.xml" />
        <include domain="sharedpref" path="quran_bookmarks.xml" />
    </device-transfer>
</data-extraction-rules>
